PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/gestion-ariane
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_MIN_32_CHARS
JWT_EXPIRES_IN=7d
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Seed admin — npm run seed:admin (remplir le mot de passe uniquement dans .env)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
SEED_ADMIN_FIRST_NAME=Admin
SEED_ADMIN_LAST_NAME=Ariane
# true = réaligne mot de passe / rôle admin sur l’email existant (dev), puis repasser à false
SEED_ADMIN_FORCE=false
